<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Lyrava.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiVersion>10.0.110</MauiVersion>
    <ApplicationTitle>Lyrava</ApplicationTitle>
    <ApplicationId>org.iotsharp.lyrava</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Compilation floors, not an accepted device support matrix. -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <!-- The first Windows slice is an unpackaged desktop build; MSIX is a separate release gate. -->
    <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <ProjectReference Include="../Lyrava.Core/Lyrava.Core.csproj" />
    <ProjectReference Include="../Lyrava.Sources.YouTube/Lyrava.Sources.YouTube.csproj" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#173A38" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#173A38" BaseSize="128,128" />
  </ItemGroup>
</Project>
